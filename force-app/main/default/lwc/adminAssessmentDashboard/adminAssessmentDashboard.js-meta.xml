<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Assignment Assessment Dashboard</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="dashboardSubtitle"
                type="String"
                label="Instruction Text"
                description="Configurable instruction shown below the Admin Console heading."
                default="Select an external student or contact to view assignments and results."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>